<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://lime.software/project/1.0.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lime.software/project/1.0.2 http://lime.software/project/1.0.2.xsd">

	<meta title=".SP Engine" description="A modded Psych Engine with extra features" package="com.yizhiru.spengine073" version="0.7.3" company="yizhiru" />

	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" />
	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false" allow-shaders="true" />

	<source path="source" />
	
	<assets path="assets/shared" rename="assets" embed="true" />

<assets path="assets/shared/images" rename="assets/images" embed="true" />
<assets path="assets/shared/sounds" rename="assets/sounds" embed="true" />
<assets path="assets/shared/music" rename="assets/music" embed="true" />
<assets path="assets/shared/data" rename="assets/data" embed="true" />
<assets path="assets/fonts" rename="assets/fonts" embed="true" />
<assets path="assets/shared/characters" rename="assets/characters" embed="true" />
<assets path="assets/shared/weeks" rename="assets/weeks" embed="true" />
<assets path="assets/shared/stages" rename="assets/stages" embed="true" />

<assets path="assets/shared/mobile" rename="assets/mobile" embed="true" />

<assets path="assets/preload" rename="assets" embed="true" />


	<haxelib name="flixel" />
	<haxelib name="flixel-addons" />
	<haxelib name="flixel-ui" />
	<haxelib name="hscript" />
	<haxelib name="lime" />
	<haxelib name="openfl" />
	<haxelib name="hxCodec" />
	<haxelib name="hxCodec" if="android" />

	<define name="mobile" />
	<define name="android" if="android" />
	<define name="MODS_ALLOWED" /> <define name="LUA_ALLOWED" />  <define name="ACHIEVEMENTS_ALLOWED" />
	<define name="VIDEOS_ALLOWED" />

	<section if="android">
		<config android:minimum-sdk-version="21" />
		<config android:target-sdk-version="33" />
		
		<android permission="android.permission.MANAGE_EXTERNAL_STORAGE" />
		<android permission="android.permission.READ_EXTERNAL_STORAGE" />
		<android permission="android.permission.WRITE_EXTERNAL_STORAGE" />
		<android permission="android.permission.VIBRATE" /> <config android:install-location="auto" />
	</section>

	<haxedef name="FLX_NO_DEBUG" if="release" />
	<haxedef name="HXCPP_CHECK_POINTER" />
	<haxedef name="HXCPP_STACK_LINE" />

	<icon path="art/iconOG.png" />
</project>
