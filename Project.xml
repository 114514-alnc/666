<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://lime.software/project/1.0.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lime.software/project/1.0.2 http://lime.software/project/1.0.2.xsd">
	<app title="SP Engine" file="SPEngine" packageName="com.yizhiru.spengine073" package="com.yizhiru.spengine073" main="Main" version="0.7.3" company="Yizhiru" />

	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/>
	<app preloader="flixel.system.FlxPreloader" />
	<set name="SWF_VERSION" value="11.8" />
	
	<define name="MODS_ALLOWED" if="desktop || mobile" />
	<define name="HSCRIPT_ALLOWED" if="desktop || mobile" />
	<define name="LUA_ALLOWED" if="desktop || mobile" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="DISCORD_ALLOWED" if="desktop" />
	<define name="COPYSTATE_ALLOWED" if="MODS_ALLOWED mobile"/>
	<define name="PSYCH_WATERMARKS"/> 
	<define name="VIDEOS_ALLOWED" if="desktop || mobile" unless="32bits || hl || NOVIDEO || rpi"/>

	<window width="1280" height="720" background="#000000" hardware="true" vsync="false" allow-high-dpi="true" />
	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false" allow-shaders="true" require-shaders="true" />

	<classpath name="source" />

	<assets path="assets/fonts" />
	
	<assets path="assets/shared" rename="assets" exclude="*.ogg" if="web"/>
	<assets path="assets/shared" rename="assets" exclude="*.mp3" unless="web"/>
	
	<assets path="assets/videos" library="videos" if="VIDEOS_ALLOWED"/>
	
	<assets path="assets/songs" library="songs" exclude="*.ogg" if="web"/>
	<assets path="assets/songs" library="songs" exclude="*.mp3" unless="web"/>

	<library name="videos" preload="true" if="VIDEOS_ALLOWED"/>
	<library name="songs" preload="true" />

	<section if="MODS_ALLOWED">
		<assets path='example_mods' rename='mods' embed='false'/>
	</section>

	<haxelib name="flixel" />
	<haxelib name="flixel-ui" />
	<haxelib name="flixel-addons" />
	<haxelib name="tjson" />

	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="SScript" if="HSCRIPT_ALLOWED"/>
	<haxelib name="hxCodec" if="VIDEOS_ALLOWED"/> <haxelib name="flxanimate"/>
	<haxelib name="extension-androidtools" if="android" />

	<section if="android">
		<config android:minimum-sdk-version="21" />
		<config android:target-sdk-version="33" />
		<android permission="android.permission.MANAGE_EXTERNAL_STORAGE" />
		<android permission="android.permission.READ_EXTERNAL_STORAGE" />
		<android permission="android.permission.WRITE_EXTERNAL_STORAGE" />
	</section>

	<section if="cpp">
		<haxedef name="HXCPP_CHECK_POINTER" />
		<haxedef name="HXCPP_STACK_LINE" />
		<haxedef name="HXCPP_STACK_TRACE" />
		<haxedef name="HXCPP_CATCH_SEGV" />
	</section>
	
	<haxedef name='no-deprecation-warnings' />
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<icon path="art/iconOG.png" />
</project>
